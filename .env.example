# Copy this file to .env and fill in the keys you have, OR just export
# these as real environment variables in your shell before running prts_bot.py.
#
# You only need to fill in the key(s) for the backend(s) you plan to use.
# Ollama needs no key at all.

GEMINI_API_KEY=
MISTRAL_API_KEY=

# Optional: only needed if Ollama runs on a non-default host/port
OLLAMA_HOST=http://localhost:11434
